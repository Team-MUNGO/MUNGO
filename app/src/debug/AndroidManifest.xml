<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- 디버그 빌드 전용 에뮬레이터 실내 온도 덮어쓰기 (DebugTemperature) -->
        <receiver
            android:name="com.example.poco.debug.DebugTemperatureReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.poco.DEBUG_TEMP" />
            </intent-filter>
        </receiver>
        <!-- 디버그 빌드 전용: 휴식 제안을 바로 한 번 보낸다 (DebugRestReceiver) -->
        <receiver
            android:name="com.example.poco.debug.DebugRestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.poco.DEBUG_REST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
