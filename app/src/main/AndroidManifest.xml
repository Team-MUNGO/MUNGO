<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 사용하는 도메인에 맞는 퍼미션 선언해주기 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />

    <!-- Vehicle SDK: 조향각(SteeringWheel) · 브레이크 페달(Brake) · 주행거리(Odometer) 읽기 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- FusedLocation SDK: 차량 위치 · 진행 방향 (회전 시 횡가속도 계산) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- NaviHelper SDK: 목적지 · 회전 안내(TBT) · 주의 구간 · 도착 이벤트 (get*Info) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- NaviHelper SDK: 목적지 설정용 내비 화면 열기 (requestNavigationScreen) -->
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <!-- NaviHelper SDK: 쉬어 갈 곳을 경유지로 추가 · 취소 (addWaypoint / removeWaypoint) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 펫 사진: 앱 안에서 큰 사진 목록으로 고르기 (시스템 사진 선택기는 차량 화면에서 너무 작음) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android Automotive 표준: 차량 속도 · 기어 (Pleos SDK에 속도 API가 없고, Gear API는 deprecated) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- TTS, STT -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- FusedLocation SDK 서비스 바인딩 (Android 11+ 패키지 가시성) -->
    <queries>
        <package android:name="ai.pleos.playground.service.location.fused" />
    </queries>


    <application
        android:name=".PocoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.POCO">
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.POCO"
            android:windowSoftInputMode="adjustResize">
            <!-- 방향을 고정하지 않는다: Pleos 화면 분할(2분할 · 3분할)에서 앱 창이 세로로 좁아져도
                 "창 크기를 넓게 조정하세요"로 막히지 않도록 -->
            <!-- 주행 중(기어 D)에도 화면을 띄울 수 있도록 "주의 분산 최적화" 선언.
                 없으면 AAOS가 주행 중 앱을 가린다 (주행 모드 화면 필수) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
